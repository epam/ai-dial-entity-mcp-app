{
  "name": "ai-dial-skill-mcp-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n app,host -c blue,magenta \"npm:dev:app\" \"npm:dev:host\"",
    "dev:app": "vite --configLoader runner",
    "dev:host": "MCP_APP_URL=http://localhost:4300/_mcp-app/index.html MCP_FIXTURES_DIR=$PWD/fixtures MCP_BUILT_FILE=$PWD/dist/index.html npm run dev-host -w @epam/ai-dial-mcp-app-kit",
    "build": "tsc -p tsconfig.json && vite build --configLoader runner && node scripts/check-single-file.mjs",
    "preview": "vite preview --configLoader runner",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@epam/ai-dial-mcp-app-kit": "*",
    "@epam/ai-dial-ui-kit": "^0.15.0-dev.36",
    "@floating-ui/react": "^0.27.20",
    "@tabler/icons-react": "^3.48.0",
    "classnames": "^2.5.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
